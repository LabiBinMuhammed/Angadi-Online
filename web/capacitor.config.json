{
  "appId": "com.angadi.online",
  "appName": "Angadi Online",
  "webDir": "public",
  "bundledWebRuntime": false,
  "server": {
    "androidScheme": "https",
    "cleartext": true
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 2000,
      "launchAutoHide": true,
      "backgroundColor": "#25D366",
      "showSpinner": false,
      "androidScaleType": "CENTER_CROP",
      "splashStyle": "LARGE_ICON"
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#25D366",
      "overlaysWebView": false
    },
    "Keyboard": {
      "resize": "body",
      "style": "DARK",
      "resizeOnFullScreen": true
    }
  }
}
